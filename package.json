{
  "name": "conciliador",
  "version": "1.0.0",
  "description": "Servidor Local com Interface Web para Conciliação",
  "main": "src/app.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "bundle": "esbuild src/app.ts --bundle --platform=node --format=cjs --outfile=dist/bundle.cjs --external:xlsx --external:chardet --external:iconv-lite --external:express --external:open",
    "build:exe": "npm run bundle && npx @yao-pkg/pkg dist/bundle.cjs --config pkg.config.json --target node24-win-x64 --fallback-to-source --output dist/ConciliadorFi2.exe"
  },
  "dependencies": {
    "chardet": "^2.0.0",
    "express": "^4.19.2",
    "iconv-lite": "^0.6.3",
    "open": "^10.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@yao-pkg/pkg": "^6.20.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
